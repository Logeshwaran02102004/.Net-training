@model IEnumerable<MvcApplicationPrj.Models.Customer>

@{
    ViewBag.Title = "GermanCustomers";
}

<style>
    body {
        font-family: Arial, Helvetica, sans-serif;
        background-color: #f4f6f8;
    }

    h2 {
        text-align: center;
        color: #2c3e50;
        margin-bottom: 20px;
    }

    table {
        width: 90%;
        margin: auto;
        border-collapse: collapse;
        background-color: #ffffff;
        border: 2px solid #1abc9c;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    th {
        background-color: #1abc9c;
        color: white;
        padding: 10px;
        text-transform: uppercase;
        border: 1px solid #148f77;
    }

    td {
        padding: 8px;
        text-align: center;
        border: 1px solid #cccccc;
    }

    tr:nth-child(even) {
        background-color: #f2f2f2;
    }

    tr:hover {
        background-color: #e8f8f5;
    }
</style>

<h2>Customers Residing in Germany</h2>

@if (Model != null && Model.Any())
{
    <table border="1" cellpadding="5" cellspacing="0">
        <tr>
            <th>Customer ID</th>
            <th>Company Name</th>
            <th>Contact Name</th>
            <th>City</th>
            <th>Phone</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CustomerID</td>
                <td>@item.CompanyName</td>
                <td>@item.ContactName</td>
                <td>@item.City</td>
                <td>@item.Phone</td>
            </tr>
        }
    </table>
}
else
{
    <div style="text-align:center; color:red; font-weight:bold; margin-top:20px;">
        No customers from Germany found.
    </div>
}